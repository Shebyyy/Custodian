# Custodian Bot — Environment Variables
# Copy this as .env: cp .env.example .env
# Then fill in the values below

# Discord Bot Token (from Discord Developer Portal > Bot)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# OAuth2 Client Secret (from Discord Developer Portal > General Information)
# Required for: bot authorization, direct server add
OAUTH2_CLIENT_SECRET=YOUR_OAUTH2_CLIENT_SECRET_HERE

# OAuth2 Redirect URI (set in Discord Developer Portal > OAuth2 > Redirects)
# Example: https://your-domain.com/oauth/callback
OAUTH2_REDIRECT_URI=YOUR_OAUTH2_REDIRECT_URI_HERE
